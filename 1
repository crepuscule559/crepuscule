<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Crepuscule Chat</title>
  <style>
    /* 默认主题变量 */
    :root {
      --theme-color: #FFB6C1; /* 默认粉色 */
      --bg-color: #f5f5f5;
      --chat-bg: #ededed;
      --text-color: #333;
      --bubble-me: #95ec69;
      --bubble-other: #ffffff;
      --text-bubble-me: #000;
      --text-bubble-other: #000;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
    body { background-color: var(--bg-color); color: var(--text-color); height: 100vh; display: flex; flex-direction: column; overflow: hidden; transition: background 0.3s; }

    /* 视图切换 */
    .view { display: none; flex-direction: column; height: 100%; width: 100%; position: absolute; top: 0; left: 0; }
    .view.active { display: flex; }

    /* 顶部导航条 */
    .header { height: 56px; background: var(--theme-color); color: #fff; display: flex; align-items: center; justify-content: space-between; padding: 0 16px; font-size: 18px; font-weight: bold; z-index: 10; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
    .header-btn { background: none; border: none; color: #fff; font-size: 24px; cursor: pointer; padding: 5px; }
    
    /* 主页：聊天列表 */
    .chat-list { flex: 1; background: #fff; overflow-y: auto; }
    .chat-item { display: flex; align-items: center; padding: 15px; border-bottom: 1px solid #eee; cursor: pointer; }
    .chat-item:active { background: #f9f9f9; }
    .chat-avatar { width: 50px; height: 50px; border-radius: 8px; background: #ddd; object-fit: cover; }
    .chat-info { margin-left: 15px; flex: 1; }
    .chat-name { font-size: 16px; font-weight: bold; margin-bottom: 5px; }
    .chat-preview { font-size: 13px; color: #888; }

    /* 聊天界面 */
    .chat-container { flex: 1; background-color: var(--chat-bg); background-image: url(''); background-size: cover; background-position: center; overflow-y: auto; padding: 15px; display: flex; flex-direction: column; gap: 15px; }
    
    /* 消息气泡 */
    .msg { display: flex; align-items: flex-start; max-width: 85%; }
    .msg.me { align-self: flex-end; flex-direction: row-reverse; }
    .msg.other { align-self: flex-start; }
    .msg-avatar { width: 40px; height: 40px; border-radius: 6px; object-fit: cover; flex-shrink: 0; }
    .msg-content { margin: 0 10px; padding: 10px 14px; border-radius: 8px; font-size: 15px; word-break: break-all; line-height: 1.4; position: relative; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
    .msg.me .msg-content { background: var(--bubble-me); color: var(--text-bubble-me); }
    .msg.other .msg-content { background: var(--bubble-other); color: var(--text-bubble-other); }
    
    /* 系统提示（拍一拍） */
    .msg.system { align-self: center; background: rgba(0,0,0,0.1); color: #666; font-size: 12px; padding: 4px 8px; border-radius: 4px; max-width: 100%; text-align: center; }

    /* 字卡交互按钮 */
    .card-action { display: inline-block; margin-top: 8px; padding: 6px 12px; background: rgba(0,0,0,0.05); border-radius: 4px; font-size: 13px; cursor: pointer; border: 1px solid rgba(0,0,0,0.1); }
    .card-action:active { background: rgba(0,0,0,0.1); }

    /* 底部输入栏 */
    .input-bar { height: 60px; background: #f7f7f7; border-top: 1px solid #ddd; display: flex; align-items: center; padding: 0 10px; gap: 10px; }
    .input-btn { flex: 1; height: 40px; border-radius: 6px; border: none; background: var(--theme-color); color: #fff; font-size: 16px; font-weight: bold; cursor: pointer; }
    .input-btn:active { filter: brightness(0.9); }

    /* 设置面板 (侧滑) */
    .settings-panel { position: fixed; top: 0; right: -100%; width: 85%; max-width: 400px; height: 100%; background: #fff; z-index: 100; box-shadow: -2px 0 10px rgba(0,0,0,0.1); transition: right 0.3s ease; display: flex; flex-direction: column; }
    .settings-panel.open { right: 0; }
    .settings-header { height: 56px; background: var(--theme-color); color: #fff; display: flex; justify-content: space-between; align-items: center; padding: 0 15px; font-size: 16px; font-weight: bold; }
    .settings-body { flex: 1; overflow-y: auto; padding: 15px; }
    
    .settings-group { margin-bottom: 20px; border: 1px solid #eee; border-radius: 8px; overflow: hidden; }
    .settings-group-title { background: #f9f9f9; padding: 10px 15px; font-weight: bold; font-size: 14px; color: #555; }
    .settings-item { padding: 12px 15px; border-bottom: 1px solid #eee; display: flex; flex-direction: column; gap: 8px; font-size: 14px; }
    .settings-item:last-child { border-bottom: none; }
    .settings-item label { font-weight: 500; }
    .settings-item input[type="text"], .settings-item input[type="number"], .settings-item textarea, .settings-item select {
      width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px;
    }
    .settings-item textarea { height: 80px; resize: vertical; }
    .settings-row { display: flex; gap: 10px; align-items: center; }
    
    /* 颜色选择器 */
    .color-options { display: flex; gap: 10px; }
    .color-btn { width: 30px; height: 30px; border-radius: 50%; border: 2px solid #ddd; cursor: pointer; }
    .color-btn.active { border-color: #333; transform: scale(1.1); }
    .color-pink { background: #FFB6C1; }
    .color-blue { background: #ADD8E6; }
    .color-green { background: #90EE90; }
    .color-black { background: #333; }
    .color-white { background: #fff; }

    .save-btn { width: 100%; padding: 12px; background: var(--theme-color); color: white; border: none; border-radius: 6px; font-size: 16px; margin-top: 20px; cursor: pointer; }

    /* 遮罩 */
    .overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 99; display: none; opacity: 0; transition: opacity 0.3s; }
    .overlay.open { display: block; opacity: 1; }
  </style>
</head>
